# Copy file này thành .env khi chạy local. Khi deploy lên Render, KHÔNG dùng
# file .env - khai báo từng biến này trong Render Dashboard > Environment.

# ── Database (MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=giaoxunguphuc
DB_USER=root
DB_PASS=
# Preferred (mặc định, an toàn cho cả local & cloud) | Required (bắt buộc SSL,
# dùng cho TiDB Cloud/Aiven) | None (tắt hẳn SSL)
DB_SSLMODE=Preferred

# ── JWT ── (tạo key ngẫu nhiên mới cho production, đừng tái sử dụng key cũ)
JWT_KEY=
JWT_ISSUER=GiaoxuNguPhucBE
JWT_AUDIENCE=GiaoxuNguPhucFE
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ── Email (SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Giáo xứ Ngũ Phúc
SMTP_ENABLE_SSL=true
ADMIN_EMAIL=

# ── Frontend URL (dùng cho CORS và link trong email) ──
# Local: http://localhost:3000
# Production: URL Vercel thật của bạn, vd https://giaoxunguphuc.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Port (Render tự set biến này, không cần khai báo thủ công) ──
# PORT=8080
